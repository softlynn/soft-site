{
  "name": "soft-archive-site",
  "version": "2.0.0",
  "description": "Softu's VOD archive site, local pipeline, and Softuchive desktop controller.",
  "author": "softlynn",
  "private": true,
  "homepage": ".",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@feathersjs/feathers": "^5.0.46",
    "@feathersjs/rest-client": "^5.0.46",
    "@google-cloud/local-auth": "^3.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.2",
    "@puckeditor/core": "^0.22.2",
    "can-autoplay": "^3.0.2",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "googleapis": "^173.0.0",
    "humanize-duration": "^3.34.0",
    "lodash.debounce": "^4.0.8",
    "react": "^19.2.8",
    "react-adsense": "^0.1.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-twemoji": "^0.6.0",
    "react-youtube": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "simplebar-react": "^3.3.2",
    "tinyduration": "^3.4.1",
    "typegpu": "^0.9.0",
    "video.js": "^8.23.9",
    "videojs-hotkeys": "^0.2.30"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.1.5"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "softuchive:start": "electron desktop/softuchive",
    "softuchive:dist": "npm ci --prefix desktop/softuchive --omit=dev --no-audit --no-fund && electron-builder --win portable",
    "youtube:auth": "node scripts/init_youtube_auth.mjs",
    "twitch:auth": "node scripts/init_twitch_user_auth.mjs",
    "archive:run": "node scripts/run_local_archive_pipeline.mjs",
    "archive:sync-metadata": "node scripts/run_local_archive_pipeline.mjs --sync-metadata-only",
    "archive:sync-youtube-visibility": "node scripts/run_local_archive_pipeline.mjs --sync-youtube-visibility-only",
    "admin:api:start": "node scripts/run_local_admin_api.mjs",
    "admin:api:wake": "powershell -ExecutionPolicy Bypass -File scripts/start_admin_api_once.ps1",
    "admin:api:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop_admin_api.ps1",
    "admin:protocol:install": "powershell -ExecutionPolicy Bypass -File scripts/install_admin_protocol_handler.ps1",
    "admin:protocol:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove_admin_protocol_handler.ps1",
    "archive:task:install": "powershell -ExecutionPolicy Bypass -File scripts/install_local_archive_task.ps1",
    "archive:task:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove_local_archive_task.ps1",
    "admin:task:install": "powershell -ExecutionPolicy Bypass -File scripts/install_local_admin_api_task.ps1",
    "admin:task:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove_local_admin_api_task.ps1",
    "twitch-ext:zip": "powershell -ExecutionPolicy Bypass -File scripts/package_twitch_panel_extension.ps1",
    "cf:reactions:whoami": "npx wrangler whoami",
    "cf:reactions:d1:create": "npx wrangler d1 create softu-reactions",
    "cf:reactions:d1:init": "npx wrangler d1 execute softu-reactions --remote --file=cloudflare/reactions-api/schema.sql",
    "cf:reactions:dev": "npx wrangler dev --config cloudflare/reactions-api/wrangler.jsonc --local",
    "cf:reactions:deploy": "npx wrangler deploy --config cloudflare/reactions-api/wrangler.jsonc"
  },
  "overrides": {
    "gaxios": "^7.3.0",
    "uuid": "^11.1.1"
  },
  "build": {
    "extends": null,
    "appId": "one.softu.softuchive",
    "productName": "Softuchive",
    "artifactName": "Softuchive-${version}-${arch}.${ext}",
    "directories": {
      "app": "desktop/softuchive",
      "output": "softuchive-dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "desktop/softuchive/assets/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
