# Local automation config. Copy to .env.local (gitignored). Never commit real values.

TWITCH_CHANNEL_LOGIN=your_twitch_login
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

LOCAL_RECORDINGS_DIR=./recordings
MIN_RECORDING_AGE_MINUTES=10
MAX_RECORDINGS_PER_RUN=1
ONLY_UPLOAD_MOST_RECENT_VOD=false
# Recordings shorter than this are not archived; VODs closer than the gap are merged into parts.
MIN_ARCHIVE_VOD_DURATION_SECONDS=300
AUTO_MERGE_VOD_GAP_SECONDS=3600

YOUTUBE_CLIENT_SECRET_PATH=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_PATH=./secrets/youtube_token.json
TWITCH_USER_TOKEN_PATH=./secrets/twitch_user_token.json
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=
TWITCH_USER_EXPIRES_IN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=20
YOUTUBE_VISIBILITY_SYNC_ENABLED=true
YOUTUBE_VISIBILITY_SYNC_INTERVAL_MINUTES=180
# Comma-separated YouTube privacy statuses that count as visible on the archive.
YOUTUBE_ARCHIVE_VISIBLE_PRIVACY_STATUSES=public
ARCHIVE_SITE_URL=https://softu.one

ARCHIVE_VODS_PATH=./public/data/vods.json
ARCHIVE_COMMENTS_DIR=./public/data/comments
ARCHIVE_EMOTES_DIR=./public/data/emotes
ARCHIVE_BADGES_PATH=./public/data/badges.json
SITE_DESIGN_PATH=./public/data/site-design.json
SITE_DESIGN_ASSETS_PATH=./public/uploads/design
PIPELINE_STATE_PATH=./scripts/.state/pipeline-state.json
PIPELINE_RUN_LOCK_PATH=./scripts/.state/pipeline-run.lock.json
PIPELINE_TMP_DIR=./scripts/.tmp
TWITCHDOWNLOADER_PATH=./scripts/tools/TwitchDownloaderCLI.exe
# Optional explicit media tool paths; otherwise ffmpeg/ffprobe come from PATH.
FFMPEG_PATH=
FFPROBE_PATH=

AUTO_GIT_PUSH=true
# Branch GitHub Pages deploys from.
GIT_PUBLISH_BRANCH=main
# Identity used for archive/admin commits (defaults to the archive bot identity).
GIT_COMMIT_AUTHOR_NAME=
GIT_COMMIT_AUTHOR_EMAIL=
LOCAL_PIPELINE_DRY_RUN=false

# Live upload progress shown on the public site (Cloudflare Worker in cloudflare/reactions-api).
# Leave the secret empty to disable reporting. It must match the Worker secret UPLOAD_STATUS_WRITE_SECRET.
UPLOAD_STATUS_API_BASE=https://softu-reactions-api.softu.workers.dev/v1/uploads
UPLOAD_STATUS_API_SECRET=

# Upload recovery tuning (seconds/attempts are safe defaults; only change when debugging stalls).
SOFTUCHIVE_UPLOAD_STALL_TIMEOUT_MS=120000
SOFTUCHIVE_MAX_UPLOAD_ATTEMPTS=3
SOFTUCHIVE_PROCESSING_STALE_AFTER_MINUTES=30
# Optional OBS dock status file; defaults to the obs-vod-track-toggle plugin location under %APPDATA%.
OBS_VOD_BYPASS_UPLOAD_STATUS_PATH=

# Local admin bridge. Use a long passphrase; sign-in locks for 30 s after 5 failures.
ADMIN_PANEL_PASSWORD=
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=49731
ADMIN_ALLOWED_ORIGINS=
ADMIN_API_IDLE_TIMEOUT_MINUTES=30
TWITCH_AUTH_TIMEOUT_SECONDS=180
ADMIN_SPOTIFY_NOTICE_TEXT=Spotify audio is muted on this VOD.
